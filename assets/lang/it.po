msgid "This release has no download for your computer."
msgstr "Questa versione non ha un download per il tuo computer."

#: src/update/updater.cpp:333
msgid "This release has no checksum file, so it can't be installed automatically."
msgstr "Questa versione non ha un file di checksum, quindi non può essere installata automaticamente."

#: src/update/updater.cpp:334
msgid "This release's download is hosted somewhere unexpected, so it won't be installed automatically."
msgstr "Il download di questa versione è ospitato in un posto inatteso, quindi non verrà installato automaticamente."

#: src/update/updater.cpp:366
msgid "Couldn't download the checksums: {0}"
msgstr "Impossibile scaricare i checksum: {0}"

#: src/update/updater.cpp:371
msgid "The release's checksum file doesn't list {0}, so it won't be installed."
msgstr "Il file di checksum della versione non elenca {0}, quindi non verrà installato."

#: src/update/updater.cpp:402
msgid "The download didn't match the release's SHA-256 checksum, so it was thrown away. Nothing was changed. Try again later."
msgstr "Il download non corrispondeva al checksum SHA-256 della versione ed è stato scartato. Non è stato modificato nulla. Riprova più tardi."

