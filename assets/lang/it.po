#: src/update/updater.cpp:98
msgid "This copy of SuperSaga isn't an app bundle, so it can't update itself."
msgstr "Questa copia di SuperSaga non è un pacchetto app, quindi non può aggiornarsi da sola."

#: src/update/updater.cpp:103
msgid "macOS is running SuperSaga from a temporary location. Move SuperSaga to your Applications folder, open it from there, and it can update itself."
msgstr "macOS esegue SuperSaga da una posizione temporanea. Sposta SuperSaga nella cartella Applicazioni e aprilo da lì: così potrà aggiornarsi da solo."

#: src/update/updater.cpp:112
msgid "SuperSaga is running from the disk image. Drag it to Applications to get automatic updates."
msgstr "SuperSaga è in esecuzione dall'immagine disco. Trascinalo in Applicazioni per avere gli aggiornamenti automatici."

#: src/update/updater.cpp:113
msgid "SuperSaga can't write to {0}, so it can't update itself there."
msgstr "SuperSaga non può scrivere in {0}, quindi non può aggiornarsi lì."

#: src/update/updater.cpp:119
msgid "Couldn't find the SuperSaga program on disk."
msgstr "Impossibile trovare il programma SuperSaga sul disco."

#: src/update/updater.cpp:127
msgid "SuperSaga can't write to its folder ({0}), so it can't update itself there."
msgstr "SuperSaga non può scrivere nella sua cartella ({0}), quindi non può aggiornarsi lì."

#: src/update/updater.cpp:132
msgid "There are no SuperSaga downloads for this kind of computer yet."
msgstr "Non ci sono ancora download di SuperSaga per questo tipo di computer."

#: src/update/updater.cpp:137
msgid "Only the AppImage version of SuperSaga updates itself. Update this copy the way you installed it."
msgstr "Solo la versione AppImage di SuperSaga si aggiorna da sola. Aggiorna questa copia nello stesso modo in cui l'hai installata."

#: src/update/updater.cpp:290
msgid "Couldn't check for updates right now (GitHub is limiting requests). SuperSaga will try again the next time it opens."
msgstr "Impossibile cercare aggiornamenti ora (GitHub sta limitando le richieste). SuperSaga riproverà alla prossima apertura."

#: src/update/updater.cpp:293
msgid "Couldn't check for updates right now (GitHub had a problem). Try again later."
msgstr "Impossibile cercare aggiornamenti ora (GitHub ha avuto un problema). Riprova più tardi."

#: src/update/updater.cpp:305
msgid "Couldn't understand the version number \"{0}\"."
msgstr "Numero di versione non comprensibile: \"{0}\"."

